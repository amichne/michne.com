---
layout: base.njk
title: Home
---
<section class="intro" aria-labelledby="intro-title">
    <div class="eyebrow"><span class="page-mark" aria-hidden="true">~</span> The index <span class="meta-divider">/</span> Software &amp; photography</div>
    <h1 id="intro-title">An engineer’s<br> <em>notebook.</em></h1>
    <div class="intro-bottom">
        <p>Notes on software.<br>Photographs from elsewhere.</p>
        <div class="desk-links"><a href="mailto:austin@michne.com">Email <span class="link-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/amichne">GitHub <span class="link-arrow" aria-hidden="true">↗</span></a></div>
    </div>
</section>
<section class="recent-posts" aria-labelledby="recent-notes">
    <div class="section-heading"><h2 id="recent-notes"><span class="section-number">01</span> Recent notes</h2><a class="utility-link" href="/posts/">All notes <span class="link-arrow" aria-hidden="true">→</span></a></div>
    <ol class="post-list">
        {% for post in collections.posts %}
        <li><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><a href="{{ post.url }}"><span>{{ post.data.title }}</span><span class="link-arrow" aria-hidden="true">↗</span></a></li>
        {% endfor %}
    </ol>
</section>
{% set photos = collections.photos %}
{% if photos.length %}
{% set photo = photos[0] %}
<section class="recent-photos" aria-labelledby="selected-frame">
    <div class="section-heading"><h2 id="selected-frame"><span class="section-number">02</span> A frame from the archive</h2><button class="utility-link shuffle-photo" type="button" hidden>Another frame <span class="link-arrow" aria-hidden="true">↗</span></button></div>
    <figure class="archive-frame">
        <a href="{{ photo.url }}" data-photo-link><img src="{{ photo.data.image }}" alt="Photograph from {{ photo.date | readableDate }}" data-photo-image fetchpriority="high"></a>
        <figcaption><span data-photo-caption>{{ photo.data.camera }} <span class="meta-divider">/</span> {{ photo.date | readableDate }}</span><a class="utility-link" href="/photos/">Photo archive <span class="link-arrow" aria-hidden="true">→</span></a></figcaption>
    </figure>
    <div class="photo-sources" hidden>
        {% for entry in photos %}<span data-photo-src="{{ entry.data.image }}" data-photo-url="{{ entry.url }}" data-photo-date="{{ entry.date | readableDate }}" data-photo-camera="{{ entry.data.camera }}"></span>{% endfor %}
    </div>
    <p class="sr-only" data-photo-status aria-live="polite"></p>
</section>
{% endif %}
