---
layout: base.njk
title: Home
---
<section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
        <h1 id="intro-title">{{ site.author }}</h1>
        <p class="intro-role">Backend Engineer @ American Express</p>
    </div>
    <div class="intro-links"><a href="mailto:austin@michne.com">Email</a><a href="https://github.com/amichne">GitHub <span aria-hidden="true">↗</span></a></div>
</section>
<section class="recent-posts" aria-labelledby="recent-notes">
    <div class="section-heading"><h2 id="recent-notes">Recent posts</h2><a class="utility-link" href="/posts/">All posts <span class="link-arrow" aria-hidden="true">→</span></a></div>
    <ol class="post-list">
        {% for post in collections.posts %}
        <li><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><a href="{{ post.url }}"><span>{{ post.data.title }}</span><span class="link-arrow" aria-hidden="true">↗</span></a></li>
        {% endfor %}
    </ol>
</section>
{% set photos = collections.photos %}
{% if photos.length %}
{% set photo = photos[0] %}
<section class="home-photo" aria-labelledby="selected-frame">
    <a class="home-photo-image" href="{{ photo.url }}">{% image photo.data.image, "Photograph from " + (photo.date | readableDate), "(max-width: 599px) 76px, (max-width: 959px) 120px, 154px" %}</a>
    <div>
        <h2 id="selected-frame"><a href="/photos/">Photographs <span class="link-arrow" aria-hidden="true">→</span></a></h2>
        <p>Latest frame <span class="meta-divider">/</span> <time datetime="{{ photo.date | isoDate }}">{{ photo.date | readableDate }}</time></p>
    </div>
</section>
{% endif %}
