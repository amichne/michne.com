---
layout: base.njk
title: Notes
---
<header class="page-header">
    <div class="eyebrow"><span class="page-mark" aria-hidden="true">~</span> The notebook <span class="meta-divider">/</span> 01</div>
    <h1>Engineering notes.</h1>
</header>
<ol class="post-list">
    {% for post in collections.posts %}
    <li><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><a href="{{ post.url }}"><span>{{ post.data.title }}</span><span class="link-arrow" aria-hidden="true">↗</span></a></li>
    {% endfor %}
</ol>
