---
layout: base.njk
title: Posts
---
<header class="page-header">
    <div class="eyebrow" aria-hidden="true"><span class="page-mark">~</span></div>
    <h1>$ ls posts/</h1>
</header>
<ol class="post-list">
    {% for post in collections.posts %}
    <li><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><a href="{{ post.url }}"><span>{{ post.data.title }}</span><span class="link-arrow" aria-hidden="true">↗</span></a></li>
    {% endfor %}
</ol>
