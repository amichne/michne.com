<!DOCTYPE html>
{% set section = page.url | pageSection %}
<html lang="en" data-theme="light" data-section="{{ section }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <script src="/js/site.js" defer></script>
</head>
<body id="top">
<a class="skip-link" href="#main">Skip to content</a>
<div class="notebook">
    <header class="site-header">
        <a href="/" class="wordmark" aria-label="$ whoami, home">
            <span class="tilde" aria-hidden="true">~</span>
            <span>{{ site.title }}</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <a href="/posts/" {% if section == "notes" %}aria-current="location"{% endif %}>posts</a>
            <a href="/photos/" {% if section == "photos" %}aria-current="location"{% endif %}>photos</a>
            <a href="/about/" {% if section == "about" %}aria-current="location"{% endif %}>about</a>
            <button class="theme-toggle" type="button" aria-label="Use dark theme" aria-pressed="false" hidden>
                <span class="theme-dot" aria-hidden="true"></span><span data-theme-label>dark</span>
            </button>
        </nav>
    </header>
    <main id="main" tabindex="-1">{{ content | safe }}</main>
    <footer class="site-footer">
        <span><span class="footer-tilde" aria-hidden="true">~</span> {{ site.author }} &middot; Built with 11ty</span>
        <a href="#top">Back to top <span class="link-arrow" aria-hidden="true">↑</span></a>
    </footer>
</div>
</body>
</html>
